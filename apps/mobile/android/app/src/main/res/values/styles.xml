<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window while the process starts, OS dark mode off. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <!-- The window behind the Flutter UI once it is up. Pinned to the same
         ground rather than the platform default, so a rotation or a resize
         never shows a strip of the wrong colour behind the app. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/ground</item>
    </style>
</resources>
