<?xml version="1.0" encoding="utf-8"?>
<!-- What the window shows between tapping the icon and Flutter's first frame.
     The ground colour follows the OS scheme via values-night, so the seam
     between this and the app is invisible. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/ground" />
    <item
        android:drawable="@drawable/ic_launcher_foreground"
        android:gravity="center" />
</layer-list>
