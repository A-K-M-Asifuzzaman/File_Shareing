# Signaling service
SIGNALING_ADDR=:8080
ALLOWED_ORIGINS=localhost:3000
SESSION_IDLE_TTL=10m
SESSION_ACTIVE_TTL=30m
SESSION_REAP_EVERY=1m
CREATE_RATE_PER_MIN=30

# Web client
NEXT_PUBLIC_SIGNALING_URL=http://localhost:8080

# ICE. STUN is enough for most pairs; TURN is the fallback when both peers are
# behind symmetric NAT. TURN relays bytes, so it costs bandwidth — off by default.
NEXT_PUBLIC_STUN_URLS=stun:stun.l.google.com:19302
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=
