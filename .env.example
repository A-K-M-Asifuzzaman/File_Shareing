# Signaling service
SIGNALING_ADDR=:8080
ALLOWED_ORIGINS=localhost:3000
SESSION_IDLE_TTL=10m
SESSION_ACTIVE_TTL=30m
SESSION_REAP_EVERY=1m
CREATE_RATE_PER_MIN=30

# Web client
NEXT_PUBLIC_SIGNALING_URL=http://localhost:8080

# ICE — server-side only, deliberately.
#
# STUN is enough whenever a direct path exists at all. TURN is the fallback for
# pairs that cannot reach each other directly; it relays bytes, so it costs
# bandwidth and is off unless credentials are set.
#
# None of this is NEXT_PUBLIC_. A relay credential shipped to a browser is a
# published credential, so the service mints short-lived ones per request and
# the client asks for them at GET /api/ice. Setting a TURN secret in a
# NEXT_PUBLIC_ variable would publish it to everyone who loads the page.
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=
